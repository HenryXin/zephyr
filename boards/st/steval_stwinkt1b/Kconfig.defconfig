if BOARD_STEVAL_STWINKT1B

if BT

config BT_BLUENRG_ACI
	default y

# Disable Flow control
config BT_HCI_ACL_FLOW_CONTROL
	default n

config BT_HCI_VS
	default n

endif # BT

source "boards/common/usb/Kconfig.cdc_acm_serial.defconfig"

endif # BOARD_STEVAL_STWINKT1B
