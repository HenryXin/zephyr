/dts-v1/;
#include <st/l4/stm32l4r9Xi.dtsi>
#include <st/l4/stm32l4r9z(g-i)jx-pinctrl.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	compatible = "st,steval_stwinkt1b";
	model = "STMicroelectronics STEVAL-STWINKT1B Development kit";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;

		zephyr,bt-hci = &hci_spi;
	};

	leds {
		compatible = "gpio-leds";

		green_led: led_1 {
			gpios = <&gpioe 1 GPIO_ACTIVE_HIGH>;
			label = "LED_1";
		};

		orange_led: led_2 {
			gpios = <&gpiod 0 GPIO_ACTIVE_HIGH>;
			label = "LED_2";
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		user_button: button {
			label = "User";
			gpios = <&gpioe 0 GPIO_ACTIVE_HIGH>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	aliases {
		accel0 = &iis2dh;
		led0 = &green_led;
		led1 = &orange_led;
		sw0 = &user_button;
		mcuboot-led0 = &green_led;
		mcuboot-button0 = &user_button;
		watchdog0 = &iwdg;
		die-temp0 = &die_temp;
		volt-sensor0 = &vref;
		volt-sensor1 = &vbat;
	};
};

&clk_hsi48 {
	status = "okay";
};

&clk_hse {
	clock-frequency = <DT_FREQ_M(16)>;
	status = "okay";
};

&clk_lse {
	status = "okay";
};

&pll {
	div-m = <4>;
	mul-n = <40>;
	div-p = <7>;
	div-q = <4>;
	div-r = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(80)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <1>;
	apb2-prescaler = <1>;
};

&gpioe {
	status = "okay";

	/* Enable 2.7V Analog LDO */
	ldo-enable-gpios {
		gpio-hog;
		gpios = <13 GPIO_ACTIVE_HIGH>;
		output-high;
	};
};

&usart2 {
	pinctrl-0 = <&usart2_tx_pd5 &usart2_rx_pd6>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&spi2 {
	pinctrl-0 = <&spi2_sck_pd1 &spi2_miso_pd3 &spi2_mosi_pc3>;
	pinctrl-names = "default";
	cs-gpios = <&gpiog 5 GPIO_ACTIVE_LOW>;
	status = "okay";

	hci_spi: bluenrg-m2@0 {
		compatible = "st,hci-spi-v2";
		reg = <0>;
		reset-gpios = <&gpioa 8 GPIO_ACTIVE_LOW>;
		irq-gpios = <&gpiog 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		spi-cpha; /* CPHA=1 */
		spi-hold-cs;
		spi-max-frequency = <DT_FREQ_M(1)>;
		reset-assert-duration-ms = <6>;
	};
};

&spi3 {
	pinctrl-0 = <&spi3_sck_pb3 &spi3_miso_pb4 &spi3_mosi_pb5>;
	pinctrl-names = "default";

	cs-gpios = <&gpiof 13 GPIO_ACTIVE_LOW>,
		   <&gpiof 5 GPIO_ACTIVE_LOW>,
		   <&gpiod 15 GPIO_ACTIVE_LOW>;
	status = "okay";

	ism330dhcx: ism330dhcx@0 {
		compatible = "st,ism330dhcx";
		reg = <0>;
		spi-max-frequency = <DT_FREQ_M(10)>;
		drdy-gpios = <&gpiof 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		int-pin = <2>;
	};

	/*
	 * IIS3DWB is present on SPI3 CS1 (PF5), INT1=PE14, INT2=PB2.
	 * The Zephyr driver is async/RTIO-only; leave disabled for sync samples.
	 */
	iis3dwb: iis3dwb@1 {
		compatible = "st,iis3dwb";
		reg = <1>;
		spi-max-frequency = <DT_FREQ_M(10)>;
		int1-gpios = <&gpioe 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		int2-gpios = <&gpiob 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		status = "disabled";
	};

	iis2dh: iis2dh@2 {
		compatible = "st,iis2dh";
		reg = <2>;
		spi-max-frequency = <DT_FREQ_M(10)>;
	};
};

&i2c2 {
	pinctrl-0 = <&i2c2_scl_pf1 &i2c2_sda_pf0>;
	pinctrl-names = "default";
	scl-gpios = <&gpiof 1 GPIO_ACTIVE_HIGH>;
	sda-gpios = <&gpiof 0 GPIO_ACTIVE_HIGH>;
	clock-frequency = <I2C_BITRATE_FAST>;
	status = "okay";

	iis2mdc@1e {
		compatible = "st,iis2mdc";
		reg = <0x1e>;
		drdy-gpios = <&gpiof 9 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	stts751@48 {
		compatible = "st,stts751";
		reg = <0x48>;
		drdy-gpios = <&gpioe 15 GPIO_ACTIVE_LOW>;
		status = "okay";
	};

	lps22hh@5d {
		compatible = "st,lps22hh";
		reg = <0x5d>;
		status = "okay";
	};

	hts221@5f {
		compatible = "st,hts221";
		reg = <0x5f>;
		drdy-gpios = <&gpioe 6 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
};

&rng {
	/* Change clock source to avoid using MSI */
	clocks = <&rcc STM32_CLOCK(AHB2, 18)>,
		 <&rcc STM32_SRC_PLL_Q CLK48_SEL(2)>;
	status = "okay";
};

zephyr_udc0: &usbotg_fs {
	pinctrl-0 = <&usb_otg_fs_dm_pa11 &usb_otg_fs_dp_pa12>;
	pinctrl-names = "default";
	status = "okay";
};

#include <../boards/common/usb/cdc_acm_serial.dtsi>

&adc123_common {
	st,adc-clock-source = "SYNC";
	st,adc-prescaler = <1>;
	status = "okay";
};

&adc1 {
	status = "okay";
};

&die_temp {
	status = "okay";
};

&iwdg {
	status = "okay";
};

&vref {
	status = "okay";
};

&vbat {
	status = "okay";
};

&sdmmc1 {
	pinctrl-0 = <&sdmmc1_d0_pc8 &sdmmc1_d1_pc9
		     &sdmmc1_d2_pc10 &sdmmc1_d3_pc11
		     &sdmmc1_ck_pc12 &sdmmc1_cmd_pd2>;
	pinctrl-names = "default";
	cd-gpios = <&gpiob 12 GPIO_ACTIVE_LOW>;
	bus-width = <4>;
	clk-div = <4>;
	disk-name = "SD";
	status = "okay";
};

&flash0 {
	partitions {
		ranges;
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			compatible = "zephyr,mapped-partition";
			reg = <0x00000000 DT_SIZE_K(64)>;
			label = "mcuboot";
		};

		slot0_partition: partition@10000 {
			compatible = "zephyr,mapped-partition";
			reg = <0x00010000 DT_SIZE_K(416)>;
			label = "image-0";
		};

		slot1_partition: partition@78000 {
			compatible = "zephyr,mapped-partition";
			reg = <0x00078000 DT_SIZE_K(424)>;
			label = "image-1";
		};

		storage_partition: partition@f0000 {
			compatible = "zephyr,mapped-partition";
			reg = <0x000f0000 DT_SIZE_K(64)>;
			label = "storage";
		};
	};
};
