config SOC_SERIES_RA2E2
	select ARM
	select CPU_CORTEX_M23
	select CPU_HAS_ARM_MPU
	select HAS_RENESAS_RA_FSP
	select CPU_CORTEX_M_HAS_VTOR
	select CPU_CORTEX_M_HAS_SYSTICK
	select CLOCK_CONTROL_RENESAS_RA_CGC if CLOCK_CONTROL
	select HAS_SWO
	select SOC_RA_DYNAMIC_INTERRUPT_NUMBER

if SOC_SERIES_RA2E2

config RENESAS_PN_PACKAGE_TYPE
	int
	range 1 3
	default 1 if SOC_R7FA2E2A72DNK
	help
	  Package type:
	  1 -> NK: HWQFN 24 pins
	  2 -> NJ: HWQFN 20 pins
	  3 -> BY: WLCSP 16 pins

endif # SOC_SERIES_RA2E2
