config SOC_SERIES_RA2E2
	bool
	select SOC_FAMILY_RENESAS_RA

config SOC_R7FA2E2A72DNK
	bool
	select SOC_SERIES_RA2E2

config SOC_SERIES
	default "ra2e2" if SOC_SERIES_RA2E2

config SOC
	default "r7fa2e2a72dnk" if SOC_R7FA2E2A72DNK
